{
  "extends": [
    "@rocketseat/eslint-config/react",
    "plugin:storybook/recommended"
  ],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {
        "no-undef": "off",
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": [
          "error",
          { "ignoreRestSiblings": true }
        ],
        "no-void": ["error", { "allowAsStatement": true }]
      }
    }
  ]
}
